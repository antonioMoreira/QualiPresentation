@article{contributing_to_discourse_1989,
  abstract      = {For people to contribute to discourse, they must do more than utter the right sentence at the right time. The basic requirement is that they add to their common ground in an orderly way. To do this, we argue, they try to establish for each utterance the mutual belief that the addressees have understood what the speaker meant well enough for current purposes. This is accomplished by the collective actions of the current contributor and his or her partners, and these result in units of conversation called contributions. We present a model of contributions and show how it accounts for a variety of features of everyday conversations.},
  author        = {Herbert H. Clark and Edward F. Schaefer},
  doi           = {https://doi.org/10.1016/0364-0213(89)90008-6},
  issn          = {0364-0213},
  journal       = {Cognitive Science},
  number        = {2},
  pages         = {259--294},
  title         = {Contributing to discourse},
  url           = {https://www.sciencedirect.com/science/article/pii/0364021389900086},
  volume        = {13},
  year          = {1989}
}
@article{Conv_Naturalness_Predictor,
  abstractnote  = {Evaluation of conversational naturalness is essential for developing human-like speech agents. However, existing speech naturalness predictors are often designed to assess utterances from a single speaker, failing to capture conversation-level naturalness qualities. In this paper, we present a framework for an automatic naturalness predictor for two-speaker, multi-turn conversations. We first show that existing naturalness estimators have low, or sometimes even negative, correlations with conversational naturalness, based on conversational recordings annotated with human ratings. We then propose a dual-channel naturalness estimator, in which we investigate multiple pre-trained encoders with data augmentation. Our proposed model achieves substantially higher correlation with human judgments compared to existing naturalness predictors for both in-domain and out-of-domain conditions.},
  author        = {Xu, Anfeng and Gaur, Yashesh and Kanda, Naoyuki and Ouyang, Zhicheng and Zmolikova, Katerina and Raj, Desh and Merello, Simone and Sun, Anna and Kalinli, Ozlem},
  doi           = {10.48550/arXiv.2603.01467},
  journal       = {},
  month         = {3},
  note          = {arXiv:2603.01467 [eess]},
  number        = {arXiv:2603.01467},
  publisher     = {arXiv},
  title         = {Conversational Speech Naturalness Predictor},
  url           = {http://arxiv.org/abs/2603.01467},
  year          = {2026}
}
