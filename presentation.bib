@inproceedings{ostendorfwightman1991,
  title        = {Automatic recognition of prosodic phrases},
  author       = {C. Wightman and M. Ostendorf},
  year         = 1991,
  month        = {apr},
  booktitle    = {Acoustics, Speech, and Signal Processing, IEEE International Conference on},
  publisher    = {IEEE Computer Society},
  address      = {Los Alamitos, CA, USA},
  pages        = {321--324},
  doi          = {10.1109/ICASSP.1991.150341},
  url          = {https://doi.ieeecomputersociety.org/10.1109/ICASSP.1991.150341},
  abstract     = {
    The authors report on the development of two algorithms to automatically
    detect prosodic phrases. The first algorithm uses simple frame-based
    likelihood classifiers to detect breaths and silences, which yields a large
    percentage of major phrase breaks. To label other levels of prosodic
    structure, a second algorithm is introduced that uses phoneme durations
    given by a speech recognizer in conjunction with a tree quantizer and
    hidden Markov model to label a hierarchy of prosodic phrase breaks. This
    second algorithm yields phrase break predictions that have good correlation
    with hand labels, and correctly detects more than 90% of the major phrase
    boundaries.
  }
}

