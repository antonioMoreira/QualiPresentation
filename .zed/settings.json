{
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "auxDirectory": ".build",
          "build": {
            "onSave": true,
            "forwardSearchAfter": true,
            "executable": "latexmk",
            "args": ["%f"]
          },
          "forwardSearch": {
            "executable": "zathura",
            "args": [
              "--synctex-forward",
              "%l:1:%f",
              "-x",
              "zed '%{input}':%{line}",
              "%p"
            ]
          }
        }
      }
    }
  },
  "languages": {
    "LaTeX": {
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "tex-fmt",
          "arguments": ["--stdin"]
        }
      }
    },
    "BibTeX": {
      "tab_size": 2,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "bash",
          "arguments": ["scripts/tidy-bib.sh", "--stdin"]
        }
      }
    },
    "Perl": {
      "language_servers": []
    }
  }
}
